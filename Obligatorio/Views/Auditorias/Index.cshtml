@model IEnumerable<AuditoriaDTO>

@{
    ViewData["Title"] = "Auditoría";

    var historias = ViewBag.Historias as IEnumerable<HistoriaResumenDTO>
        ?? Enumerable.Empty<HistoriaResumenDTO>();

    var administradores = ViewBag.Administradores as IEnumerable<UsuarioDTO>
        ?? Enumerable.Empty<UsuarioDTO>();

    int? historiaSeleccionada = ViewBag.HistoriaId;
    int? administradorSeleccionado = ViewBag.AdministradorId;

    var registros = Model.ToList();
}

<div class="container mt-4">

    <h2>Auditoría de historias</h2>

    <p class="text-muted">
        Registro de acciones realizadas por los administradores.
    </p>

    <form asp-controller="Auditorias"
          asp-action="Index"
          method="get"
          class="row g-3 mb-4">

        <div class="col-md-5">
            <label class="form-label">Historia</label>

            <select name="historiaId" class="form-select">

                <option value="">Todas las historias</option>

                @foreach (var historia in historias)
                {
                    <option value="@historia.Id"
                            selected="@(historiaSeleccionada == historia.Id)">
                        @historia.Titulo
                    </option>
                }

            </select>
        </div>

        <div class="col-md-4">
            <label class="form-label">Administrador</label>

            <select name="administradorId" class="form-select">

                <option value="">Todos los administradores</option>

                @foreach (var administrador in administradores)
                {
                    <option value="@administrador.Id"
                            selected="@(administradorSeleccionado == administrador.Id)">
                        @administrador.NombreUsuario
                    </option>
                }

            </select>
        </div>

        <div class="col-md-3 d-flex align-items-end gap-2">

            <button type="submit"
                    class="btn btn-primary">
                Filtrar
            </button>

            <a asp-controller="Auditorias"
               asp-action="Index"
               class="btn btn-secondary">
                Limpiar
            </a>

        </div>
    </form>

    @if (!registros.Any())
    {
        <div class="alert alert-info">
            No se encontraron registros de auditoría con esos filtros.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-striped table-bordered">

                <thead class="table-dark">
                    <tr>
                        <th>Fecha</th>
                        <th>Acción</th>
                        <th>Administrador</th>
                        <th>Historia</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var auditoria in registros)
                    {
                        <tr>
                            <td>
                                @auditoria.Fecha.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>@auditoria.Accion</td>

                            <td>@auditoria.AdministradorNombre</td>

                            <td>
                                @auditoria.HistoriaTitulo

                                @if (auditoria.HistoriaId == null)
                                {
                                    <span class="badge bg-secondary">Dada de baja</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>
    }

    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-outline-secondary mt-3">
        Volver al inicio
    </a>

</div>
